rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is signed in
    function isAuthenticated() {
      return request.auth != null;
    }

    // Validation helper for ID format
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Public read and open posting for jobs
    match /jobs/{jobId} {
      allow read: if true;
      allow write: if isValidId(jobId);
    }

    // Applicants submitted by job seekers
    match /applicants/{applicantId} {
      allow read, write: if isValidId(applicantId);
    }

    // Scheduled interviews
    match /interviews/{interviewId} {
      allow read, write: if isValidId(interviewId);
    }

    // Candidate Profiles
    match /candidateProfiles/{profileId} {
      allow read, write: if isValidId(profileId);
    }

    // Registered User Accounts
    match /users/{userId} {
      allow read: if true;
      allow write: if isValidId(userId);
    }

    // Test connection document
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
