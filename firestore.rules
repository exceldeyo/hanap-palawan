rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is signed in
    function isAuthenticated() {
      return request.auth != null;
    }

    // Validation helper for ID format
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Public and authenticated read for jobs; authenticated write
    match /jobs/{jobId} {
      allow read: if isValidId(jobId);
      allow create, update, delete: if isAuthenticated() && isValidId(jobId);
    }

    // Applicants submitted by job seekers
    match /applicants/{applicantId} {
      allow read, write: if isAuthenticated() && isValidId(applicantId);
    }

    // Scheduled interviews
    match /interviews/{interviewId} {
      allow read, write: if isAuthenticated() && isValidId(interviewId);
    }

    // Candidate Profiles
    match /candidateProfiles/{profileId} {
      allow read, write: if isAuthenticated() && isValidId(profileId);
    }

    // Test connection document
    match /test/{docId} {
      allow read: if true;
    }
  }
}
